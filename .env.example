# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local dev: any local Postgres works, e.g. `createdb takenwalk_dev` then:
#   postgresql://<os-user>@localhost:5432/takenwalk_dev?schema=public
# Production: point this at your hosted Postgres (Neon, Supabase, etc.) —
# swapping this one value is the entire migration, nothing else changes.
DATABASE_URL=""

# --- Admin auth ---------------------------------------------------------------
# AUTH_SECRET is read by NextAuth (Auth.js v5). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ADMIN_EMAIL / ADMIN_PASSWORD are only used once, by `npm run db:seed`, to
# create the single seeded AdminUser row (bcrypt-hashed before storage).
# There is no public /register route — this is the only way an admin account
# gets created. Change ADMIN_PASSWORD here and re-seed to rotate it.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Map + Geocoding (OpenStreetMap-based, no API key required) ---------------
# Map tiles: MapLibre GL JS rendering an OpenFreeMap style (free, no key, no
# rate limit — https://openfreemap.org). Leave unset to use their public
# "positron" style. Override to point at MapTiler/Stadia/a self-hosted style
# later without touching any component code.
NEXT_PUBLIC_MAP_STYLE_URL=""

# Geocoding: Nominatim (OSM's geocoder). The public instance is rate-limited
# to 1 request/second and REQUIRES a real identifying User-Agent per its
# usage policy (https://operations.osmfoundation.org/policies/nominatim/) —
# set GEOCODING_USER_AGENT to your app name + a contact email before
# production use, or you risk getting blocked. Geocoding only ever runs from
# admin create/edit actions, never on public map load, so the public
# instance is fine at Piwoyi's current scale. The provider lives behind
# src/lib/geocoding/ — swap in a paid or self-hosted provider later by
# editing one line in src/lib/geocoding/index.ts.
NOMINATIM_BASE_URL=""
GEOCODING_USER_AGENT="TakenWalk/1.0 (contact: you@example.com)"

# --- Photo storage (Vercel Blob) -----------------------------------------------
# Without this, uploaded photos fall back to local disk (public/uploads/) —
# fine for local dev, NOT fine in production (Vercel's filesystem is
# ephemeral). Get a token from the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=""

# --- Payments (Paystack) -------------------------------------------------------
# Only the secret key is ever used server-side — checkout uses Paystack's
# hosted redirect flow (no client-side JS SDK, no public key needed), which
# keeps the request page light for slow connections. Without this set, the
# "Pay Online" option is hidden and the free-text/cash request flow works
# exactly as before.
#
# Use TEST keys (sk_test_...) here for local dev — get them from the
# Paystack dashboard with the "Test Mode" toggle on. Never put a LIVE key
# (sk_live_...) in this file; live keys belong only in Vercel's production
# env vars. Also configure a webhook URL in the Paystack dashboard pointing
# at https://<your-domain>/api/webhooks/paystack for both test and live mode.
PAYSTACK_SECRET_KEY=""

# --- Demo data (never for production) ------------------------------------------
# Must be the literal string "true" to enable `npm run db:seed:demo`. Leave
# unset in Production/Preview — real Piwoyi data must never mix with demo rows.
DEMO_MODE=""
